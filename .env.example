# Configuración Centralizada de Analítica y Conversiones
# NO modifique estos valores con datos falsos.
# Renombre este archivo a .env.local e introduzca los IDs reales cuando los tenga.

# Google Tag Manager (Recomendado para manejar todo de forma unificada)
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads Global Tag
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Labels (Identificadores específicos para cada acción)
NEXT_PUBLIC_GADS_CONVERSION_WHATSAPP=
NEXT_PUBLIC_GADS_CONVERSION_PHONE=
NEXT_PUBLIC_GADS_CONVERSION_FORM=
NEXT_PUBLIC_GADS_CONVERSION_QUOTE=
